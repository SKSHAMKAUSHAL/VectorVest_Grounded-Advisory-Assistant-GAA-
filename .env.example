# ==============================================================================
# Grounded Advisory Assistant (GAA) — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root or 'backend/.env' and fill in your keys.

# ------------------------------------------------------------------------------
# 1. LLM Provider & Inference API Keys
# ------------------------------------------------------------------------------
# Active LLM Provider: 'groq' (recommended for ultra-low latency) or 'openai'
LLM_PROVIDER="groq"

# Groq Cloud API Key (Get free API key at: https://console.groq.com/keys)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.1-70b-versatile"

# OpenAI API Key (Get API key at: https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-your_openai_api_key_here"
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ------------------------------------------------------------------------------
# 2. Zero-Hallucination Guardrail Gate
# ------------------------------------------------------------------------------
# Minimum cosine similarity threshold required to allow response generation.
# Queries scoring below 0.68 trigger the deterministic compliance refusal.
SIMILARITY_THRESHOLD=0.68

# ------------------------------------------------------------------------------
# 3. Database & Vector Storage
# ------------------------------------------------------------------------------
# Relational DB connection string (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="sqlite:///./data/app.db"

# ChromaDB local persistence directory for vector embeddings
CHROMA_PERSIST_DIR="./data/chromadb"

# ------------------------------------------------------------------------------
# 4. Security & JWT Session Configuration
# ------------------------------------------------------------------------------
# Cryptographic secret used to sign JWT bearer access tokens
JWT_SECRET_KEY="wealthguard-production-jwt-secret-replace-with-secure-random-token"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=15

# ------------------------------------------------------------------------------
# 5. Application & Network Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Grounded Advisory Assistant"
ENVIRONMENT="development"
DEBUG=true

# Allowed CORS origins for frontend web client (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Public API URL for Next.js frontend client calls
NEXT_PUBLIC_API_URL="http://localhost:8000"
