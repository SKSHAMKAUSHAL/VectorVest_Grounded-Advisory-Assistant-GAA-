# ==============================================================================
# Grounded Advisory Assistant (Backend Environment Template)
# ==============================================================================
ENVIRONMENT="production"
DEBUG=false
PROJECT_NAME="WealthGuard AI"

# Relational Database (PostgreSQL for production, SQLite for dev)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-high-entropy-24-32-char-password-with-symbols-digits"
POSTGRES_DB="gaa_db"
DATABASE_URL="postgresql://postgres:your-high-entropy-24-32-char-password-with-symbols-digits@gaa_postgres:5432/gaa_db"

# JWT Secret & Expiry
JWT_SECRET_KEY="generate-with-openssl-rand-hex-32-minimum-32-characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=15

# LLM Inference (Groq)
LLM_PROVIDER="groq"
GROQ_API_KEY="gsk_your_groq_production_api_key_here"
GROQ_MODEL="llama-3.1-70b-versatile"

# Vector Store
VECTOR_DB_TYPE="chromadb"
VECTOR_DB_PATH="/app/data/chroma"
CHROMA_PERSIST_DIR="./data/chromadb"
SIMILARITY_THRESHOLD=0.50

# CORS
ALLOWED_ORIGINS="https://wealthguard.yourbank.com,http://localhost:3000,http://127.0.0.1:3000"
CORS_ORIGINS="https://wealthguard.yourbank.com,http://localhost:3000,http://127.0.0.1:3000"
NEXT_PUBLIC_API_URL="https://api.wealthguard.yourbank.com"
